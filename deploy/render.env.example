# Variables pour Render (Web Service Docker + Postgres)
# Copier les valeurs dans le dashboard Render ou utiliser deploy/render.yaml

# --- Image Docker Hub ---
# DOCKERHUB_USER=rutkarf
# IMAGE=docker.io/${DOCKERHUB_USER}/r4v3chain-backend:1.0.0  # actuel ; → r4v3chain-backend après INFRA-MIGRATION

# --- Service ---
PORT=8080
SPRING_PROFILES_ACTIVE=postgres,prod
R4V3CHAIN_PERSISTENCE_MODE=postgres
JAVA_TOOL_OPTIONS=-Xmx384m

# --- Postgres (Render : host/port/db/user/password auto via deploy/render.yaml) ---
# Override JDBC complet si besoin :
# DATABASE_JDBC_URL=jdbc:postgresql://HOST:5432/r4v3chain
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=r4v3chain
DATABASE_USERNAME=r4v3chain
DATABASE_PASSWORD=CHANGE_ME

# --- Secrets (générer : cd apps/r4v3chain-backend && npm run secrets:generate) ---
R4V3CHAIN_JWT_SECRET=CHANGE_ME_MIN_32_CHARS
R4V3CHAIN_ACTUATOR_TOKEN=CHANGE_ME_MIN_24_CHARS

# --- CORS : URL Cloudflare Pages du frontend ---
R4V3CHAIN_CORS_EXTRA=https://YOUR-PROJECT.pages.dev

# --- Health check Render ---
# Path: /api/health
# Port: 8080
